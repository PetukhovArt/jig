{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PetukhovArt/jig/main/schema/config.schema.json",
  "title": "jig project config",
  "description": ".jig/config.jsonc (in git) and .jig/config.local.jsonc (outside git, laid over it: objects merge by key, checks by name, other values replace). jig reads only these files; nothing outside them runs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "jig's own rules. Suppression directives are always denied; these levels set the gates for new comments and new test cases (default error for both).",
      "properties": {
        "jig/comments": { "$ref": "#/$defs/severity" },
        "jig/tests": { "$ref": "#/$defs/severity" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "description": "Catalog tools by name. {} turns a tool on, false turns it off. A tool not named here never runs.",
      "properties": {
        "oxlint": { "$ref": "#/$defs/tool" },
        "tsc": { "$ref": "#/$defs/tool" },
        "eslint": { "$ref": "#/$defs/tool" },
        "stratum": { "$ref": "#/$defs/tool" }
      }
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Catalog proofs by name (what proves a UI change in the running app). Read by jig pre-mr.",
      "properties": {
        "agent-view": { "$ref": "#/$defs/tool" }
      }
    },
    "checks": {
      "type": "array",
      "description": "The project's own checks, run after an edit or at the end of a turn on the matching files.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "files", "on", "run"],
        "properties": {
          "name": { "type": "string", "pattern": "^[\\w.-]+$", "description": "Unique; findings use the rule check/<name>" },
          "files": { "type": "array", "items": { "type": "string" }, "description": "Globs, repo-relative with forward slashes" },
          "on": { "enum": ["edit", "stop"] },
          "run": { "type": "string", "pattern": "\\{files\\}", "description": "Command without a shell; the token {files} becomes one argument per file" },
          "format": {
            "enum": ["exit", "jsonl", "oxlint", "tsc", "eslint", "stratum"],
            "default": "exit",
            "description": "exit: a non-zero exit is one finding; jsonl: jig finding lines; a tool name: that tool's output parser"
          },
          "level": { "$ref": "#/$defs/severity", "default": "error" }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktreesDir"],
      "properties": {
        "worktreesDir": { "type": "string" },
        "install": { "type": "string" },
        "dev": { "type": "string" },
        "runtime": { "enum": ["electron", "tauri", "browser", "none"] },
        "verifyRuntime": { "enum": ["electron", "tauri", "browser"] },
        "linkedPackages": { "type": "array", "items": { "type": "string" } },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "step"],
            "properties": {
              "base": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "step": { "type": "integer", "minimum": 1 },
              "target": { "type": "string", "default": ".env" }
            }
          }
        },
        "cdp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "step"],
          "properties": {
            "base": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "step": { "type": "integer", "minimum": 1 }
          }
        },
        "instance": { "type": "object" },
        "clearCache": { "type": "array", "items": { "type": "string" } }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seedExclude": { "type": "array", "items": { "type": "string" }, "description": "Globs (repo-relative, forward slashes) that jig worktree seed skips" },
        "copyFiles": { "type": "array", "items": { "type": "string" }, "description": "Files inside fully ignored folders that jig worktree seed copies as well" }
      }
    }
  },
  "$defs": {
    "severity": { "enum": ["off", "warn", "error"] },
    "tool": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "$ref": "#/$defs/severity", "default": "error" },
            "command": { "type": "string", "minLength": 1, "description": "Replaces the catalog command, e.g. vue-tsc for tsc" },
            "ignoreRules": { "type": "array", "items": { "type": "string" }, "description": "Rule globs whose findings are dropped, e.g. boundaries/*" }
          }
        }
      ]
    }
  }
}
