{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PetukhovArt/jig/main/schema/user-config.schema.json",
  "title": "jig user config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "tiers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deep": { "$ref": "#/$defs/models" },
          "standard": { "$ref": "#/$defs/models" },
          "fast": { "$ref": "#/$defs/models" }
        }
      }
    },
    "prices": {
      "description": "Estimated US dollars per million tokens per model family (a substring of the model id), for jig review cost.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "number", "minimum": 0 },
          "output": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
