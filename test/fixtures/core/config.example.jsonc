{
  "$schema": "https://raw.githubusercontent.com/PetukhovArt/jig/main/schema/config.schema.json",
  // Tools by catalog name. {} = the definition's defaults; false = off.
  "tsc": { "command": "vue-tsc" },
  "eslint": { "ignoreRules": ["boundaries/*"] },
  "oxlint": false,
  "stratum": { "level": "warn" },
  "agent-view": {},
  // jig rules: off | warn | error. Missing keys use the default, error.
  "rules": {
    "jig/comments": "error",
    "jig/tests": "error"
  },
  // Project checks, run like catalog tools.
  "checks": [
    { "name": "unit", "files": "src/**/*.ts", "on": "stop", "run": "vitest related --run {files}" }
  ],
  "slots": {
    "worktreesDir": "..",
    "install": "npm ci --prefer-offline --no-audit --no-fund",
    "dev": "npm run dev",
    "runtime": "electron",
    "ports": { "VITE_SERVER_PORT": { "base": 3000, "step": 10, "target": ".env" } },
    "cdp": { "base": 9900, "step": 1 },
    "clearCache": []
  },
  "worktree": {
    "seedExclude": ["*.log"],
    "copyFiles": ["node_modules/.cache/keep.json"]
  }
}
